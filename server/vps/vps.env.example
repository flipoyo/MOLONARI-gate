# Settings of the molonari.io server scripts (molosite-sync, reset-data-receiver). No secret in this file.
# Installed as /etc/molonari/vps.env. Change it when the Operating Space is reloaded from another .cgs:
# see molonari.io/server/reset-data-receiver.md.
CGSHOME=/root/.cgs/MOLONARI-vps-20261111164052   # the Operating Space, as printed by `pixi run molo load`
CGS_FILE=.config/molonari-vps.cgs                # the .cgs it was loaded from, relative to CGSHOME
RECEIVER_DIR=Molonaviz                           # mount of the receiver repository (MOLONARI-API), relative to CGSHOME
RECEIVER_DB=TestDatabase/Molonari.sqlite.backup  # the database the askdb page shows, relative to RECEIVER_DIR
SITE_DB=/var/lib/molonari/Molonari.sqlite        # the file the sqlite-molonaviz plugin reads: keep it fixed
MOLOSITE_ENV=/root/.molosite.env                 # the credentials (MOLO_WP_USER, MOLO_WP_APP_PASSWORD), mode 600
